// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/templates/waybar/config.jsonc instead
{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 0,
    "modules-left": [
        "custom/logo",
        "hyprland/workspaces",
        "custom/cava"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "tray",
        "group/stats",
        "group/controls"
    ],
    "custom/logo": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{name} {windows}",
        "format-window-separator": " ",
        "window-rewrite-default": "",
        "window-rewrite": {
            "class<kitty|Alacritty|konsole>": "",
            "class<firefox|zen.*|librewolf>": "󰈹",
            "class<org.kde.dolphin>": "",
            "class<discord|vesktop|equibop>": "󰙯",
            "class<[Ss]potify|ncspot>": "",
            "class<codium|VSCodium|code>": "󰨞",
            "class<com.obsproject.Studio>": "󰑊",
            "class<steam|Steam>": "󰓓",
            "class<osu!|lazer>": "󰵯",
            "class<org.prismlauncher.PrismLauncher|Minecraft.*>": "󰍳"
        },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
        "format": "{}",
        "max-length": 45,
        "separate-outputs": true
    },
    "mpris": {
        "format": "<span color='{{colors.accent}}'>󰝚</span>  {artist} — {title}",
        "format-paused": "󰏤  {artist} — {title}",
        "max-length": 55,
        "on-click": "playerctl play-pause"
    },
    "cpu": {
        "format": "<span color='{{colors.accent}}'></span>  {usage}%",
        "interval": 3
    },
    "memory": {
        "format": "<span color='{{colors.accent}}'>󰍛</span>  {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "backlight": {
        "format": "<span color='{{colors.accent}}'>{icon}</span>  {percent}%",
        "format-icons": [
            "󰃞",
            "󰃟",
            "󰃠"
        ]
    },
    "pulseaudio": {
        "format": "<span color='{{colors.accent}}'>{icon}</span>  {volume}%",
        "format-muted": "󰝟  mute",
        "format-icons": {
            "default": [
                "󰕿",
                "󰖀",
                "󰕾"
            ]
        },
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": "<span color='{{colors.accent}}'>󰖩</span>  {essid}",
        "format-ethernet": "<span color='{{colors.accent}}'>󰈀</span>  wired",
        "format-disconnected": "󰖪  offline",
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "kitty --class nmtui -e nmtui"
    },
    "clock": {
        "format": "<span color='{{colors.accent}}'>󰅐</span>  {:%H:%M    <span color='{{colors.accent}}'>󰃭</span>  %a %d %b}",
        "format-alt": "<span color='{{colors.accent}}'>󰃭</span>  {:%A, %d %B %Y}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months": "<span color='{{colors.accent}}'><b>{}</b></span>",
                "weekdays": "<span color='{{colors.accent2}}'>{}</span>",
                "today": "<span color='{{colors.bright}}'><b><u>{}</u></b></span>"
            }
        }
    },
    "tray": {
        "spacing": 8,
        "icon-size": 15
    },
    "group/stats": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },
    "group/controls": {
        "orientation": "horizontal",
        "modules": [
            "backlight",
            "pulseaudio",
            "network"
        ]
    },
    "margin-top": 8,
    "margin-left": 16,
    "margin-right": 16,
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "format": "{}",
        "tooltip": false
    }
}