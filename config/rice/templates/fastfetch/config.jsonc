// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/templates/fastfetch/config.jsonc
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "{{fastfetch.separator}}",
        "color": { "keys": "{{colors.accent2}}", "title": "{{colors.accent}}" },
        "percent": { "color": { "green": "{{term.color2}}", "yellow": "{{term.color3}}", "red": "{{term.color1}}" } }
    },
    "modules": [
        "break",
        "title",
        { "type": "custom", "format": "\u001b[38;2;{{colors.accent2|ansi}}m{{fastfetch.rule}}" },
        { "type": "os",       "key": " os" },
        { "type": "kernel",   "key": " kernel" },
        { "type": "uptime",   "key": "󰅐 uptime" },
        { "type": "packages", "key": "󰏖 pkgs" },
        { "type": "shell",    "key": " shell" },
        { "type": "wm",       "key": " wm" },
        { "type": "terminal", "key": " term" },
        "break",
        { "type": "colors", "symbol": "{{fastfetch.symbol}}" }
    ]
}
