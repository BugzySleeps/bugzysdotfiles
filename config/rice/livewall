#!/usr/bin/env python3
"""livewall — bring a still wallpaper to life for the Quickshell shell (desktop/Wallpaper.qml, shaders/livewall.frag).

  livewall <image> <horizon-y> <outline> [pivot-x,pivot-y] [--sun cx,cy,disc,rays]

Cuts the thing floating on the water out of <image> into its own layer, so the shell can bob it on the waves
while the water ripples under it:
  <image>      the wallpaper
  <horizon-y>  where the sea meets the sky, in the image's pixels: below it is water
  <outline>    a loose outline round the floating thing, "x,y x,y ...", a little outside its edge; the blue sky
               and water inside it are trimmed off by colour
  pivot        what it rocks around (default: the middle of its waterline)
  --sun        a sun in the sky to cut out too, so it can sway and glow: its middle, the radius of its disc (all of
               it is the sun) and how far its rays reach (there, only the sun's warm colours are)

Writes <image's dir>/.live/<image's name>/:
  figure.png   the floating thing alone, edges softened
  plate.png    the picture without it (what's beside it mirrored in)
  front.png    black where the water is in front of the float, so as it bobs down it sinks into it, not over it
  sun.png      the sun alone (with --sun)
  live.json    horizon, pivot and size, for the shell
Only Pillow is needed.
"""
import json
import sys
import time
from collections import deque
from pathlib import Path

from PIL import Image, ImageChops, ImageDraw, ImageFilter


def mirror_fill(px, pl, hole, W, box):
    """Fill the hole in the plate with what's right beside it, mirrored in from the nearer side of each row, so the
    seams match (only ever seen in the few pixels a layer moves by, round its edge)."""
    hp = hole.load()
    x0, y0, x1, y1 = box
    for y in range(y0, y1 + 1):
        row = [x for x in range(x0, x1 + 1) if hp[x, y]]
        if not row:
            continue
        a, b = max(0, row[0] - 1), min(W - 1, row[-1] + 1)
        for x in range(a, b + 1):
            if hp[x, y]:
                sx = a - 1 - (x - a) if x - a < b - x else b + 1 + (b - x)
                pl[x, y] = px[min(W - 1, max(0, sx)), y]


def cut_sun(im, cx, cy, disc, rays):
    """The sun: everything inside its disc, and its warm colours (the rays) out to `rays`."""
    W, H = im.size
    px = im.load()
    m = Image.new("L", (W, H), 0)
    mp = m.load()
    for y in range(max(0, cy - rays), min(H, cy + rays + 1)):
        for x in range(max(0, cx - rays), min(W, cx + rays + 1)):
            d = ((x - cx) ** 2 + (y - cy) ** 2) ** 0.5
            r, g, b = px[x, y]
            sat = (max(r, g, b) - min(r, g, b)) / max(1, max(r, g, b))
            if d <= disc or (d <= rays and r > 200 and sat > 0.45 and g < 0.85 * r):   # rays: orange (>= 0.5), not warm cloud (<= 0.4)
                mp[x, y] = 255
    # close up the rays' little gaps, drop stray specks
    m = m.filter(ImageFilter.MaxFilter(3)).filter(ImageFilter.MinFilter(3))
    m = m.filter(ImageFilter.MinFilter(3)).filter(ImageFilter.MaxFilter(3))
    return m.filter(ImageFilter.MaxFilter(5))


def main():
    sun = None
    if "--sun" in sys.argv:
        i = sys.argv.index("--sun")
        sun = tuple(int(v) for v in sys.argv[i + 1].split(","))
        del sys.argv[i:i + 2]
    if len(sys.argv) < 4:
        sys.exit(__doc__.strip())
    src = Path(sys.argv[1]).expanduser()
    horizon = int(sys.argv[2])
    outline = [tuple(int(v) for v in p.split(",")) for p in sys.argv[3].split()]
    im = Image.open(src).convert("RGB")
    W, H = im.size
    px = im.load()

    # 1. the figure: inside the outline, minus the blue (sky, water) that reaches in from the outline's edge
    poly = Image.new("L", (W, H), 0)
    ImageDraw.Draw(poly).polygon(outline, fill=255)
    pp = poly.load()
    xs, ys = [p[0] for p in outline], [p[1] for p in outline]
    x0, x1, y0, y1 = max(0, min(xs)), min(W - 1, max(xs)), max(0, min(ys)), min(H - 1, max(ys))

    def blue(x, y):
        r, g, b = px[x, y]
        return b > r * 0.95 and r + g + b > 160          # bright enough: dark bluish hair isn't sky

    bg = set()
    todo = deque()
    for y in range(y0, y1 + 1):                  # seeds: blue pixels just inside the outline
        for x in range(x0, x1 + 1):
            if pp[x, y] and blue(x, y) and any(not pp[min(W - 1, max(0, x + dx)), min(H - 1, max(0, y + dy))]
                                               for dx, dy in ((2, 0), (-2, 0), (0, 2), (0, -2))):
                bg.add((x, y))
                todo.append((x, y))
    while todo:
        x, y = todo.popleft()
        for nx, ny in ((x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)):
            if x0 <= nx <= x1 and y0 <= ny <= y1 and (nx, ny) not in bg and pp[nx, ny] and blue(nx, ny):
                bg.add((nx, ny))
                todo.append((nx, ny))
    core = poly.copy()
    cp = core.load()
    for x, y in bg:
        cp[x, y] = 0
    # specks of blue left inside (glints, the eyes) are part of it; then close up small gaps
    core = core.filter(ImageFilter.MaxFilter(5)).filter(ImageFilter.MinFilter(5))
    cp = core.load()

    # the waterline: where the float meets the water, per column. From the float's red alone (water and glints
    # round its bottom would make it ragged), smoothed
    low = {}
    for x in range(x0, x1 + 1):
        ys_ = [y for y in range(max(y0, horizon + 40), y1 + 1) if cp[x, y] and px[x, y][0] > 70 and px[x, y][0] > 1.9 * px[x, y][2]]
        if ys_:
            low[x] = max(ys_)
    cols = sorted(low)
    water = {}
    for x in cols:
        near = sorted(low[c] for c in range(x - 9, x + 10) if c in low)
        water[x] = near[len(near) // 2]
    # nothing below the waterline is the float (it's water, glinting), nor any other bit below the horizon
    for x in range(x0, x1 + 1):
        for y in range(horizon + 1, y1 + 1):
            if cp[x, y] and (x not in water or y > water[x] + 1):
                cp[x, y] = 0
    # below the horizon it's only the float (each row, from its leftmost red to its rightmost, smoothed) and
    # whatever comes down into it from above (the neck): glinting water round it isn't red, but isn't blue either
    span = {}
    for y in range(horizon + 1, y1 + 1):
        reds = [x for x in range(x0, x1 + 1) if cp[x, y] and px[x, y][0] > 70 and px[x, y][0] > 1.9 * px[x, y][2]]
        if len(reds) > 6:
            span[y] = (reds[0], reds[-1])
    rows = sorted(span)
    smooth = {}
    for y in rows:
        near = [span[r] for r in range(y - 6, y + 7) if r in span]
        smooth[y] = (sorted(n[0] for n in near)[len(near) // 2], sorted(n[1] for n in near)[len(near) // 2])
    neck = [x for x in range(x0, x1 + 1) if cp[x, horizon]]
    nx0, nx1 = (neck[0], neck[-1]) if neck else (0, -1)
    top = rows[0] if rows else H
    for y in range(horizon + 1, y1 + 1):
        lo, hi = smooth.get(y, (W, -1))
        for x in range(x0, x1 + 1):
            if cp[x, y] and not (lo <= x <= hi or (nx0 <= x <= nx1 and y < top + 60)):
                cp[x, y] = 0

    # drop bits left clinging to it (water specks round the float), keeping its outline whole
    # (in the water only: above it, the hair's thin wisps would go too)
    opened = core.filter(ImageFilter.MinFilter(7)).filter(ImageFilter.MaxFilter(7))
    below = Image.new("L", (W, H), 0)
    ImageDraw.Draw(below).rectangle((0, horizon + 1, W, H), fill=255)
    core = Image.composite(opened, core, below)
    cp = core.load()
    # a couple of pixels wider: a thin rim lit blue by the water round it goes with it, not left behind
    core = core.filter(ImageFilter.MaxFilter(5))
    cp = core.load()
    for x in range(x0, x1 + 1):
        for y in range(horizon + 1, y1 + 1):
            if cp[x, y] and (x not in water or y > water[x] + 1):
                cp[x, y] = 0
    if len(sys.argv) > 4:
        pivot = tuple(int(v) for v in sys.argv[4].split(","))
    else:
        mid = cols[len(cols) // 2]
        pivot = (mid, water[mid] - 40)

    # 2. the plate: what's behind it (only ever seen in the few pixels it bobs by, round its edge)
    hole = core.filter(ImageFilter.MaxFilter(5))

    # the moving layer: just past its edge, softened (the filled-in plate round it is mirrored from right beside it,
    # so the rest of the hole blends in, and ripples with the water like everything else)
    alpha = hole.filter(ImageFilter.GaussianBlur(1.0))
    figure = im.copy()
    figure.putalpha(alpha)
    plate = im.copy()
    mirror_fill(px, plate.load(), hole, W, (x0, y0, x1, y1))
    sunlayer = None
    if sun:
        cx, cy, disc, rays = sun
        sunhole = cut_sun(im, cx, cy, disc, rays)
        sunlayer = im.copy()
        sunlayer.putalpha(sunhole.filter(ImageFilter.GaussianBlur(1.0)))
        mirror_fill(px, plate.load(), sunhole, W, (max(0, cx - rays), max(0, cy - rays), min(W - 1, cx + rays), min(H - 1, cy + rays)))
        hole = ImageChops.lighter(hole, sunhole)
    # soften the seams of the fill a touch (only inside the holes)
    soft = plate.filter(ImageFilter.GaussianBlur(1.5))
    plate = Image.composite(soft, plate, hole.filter(ImageFilter.GaussianBlur(2)))

    # the water in front: below the waterline, so a float sinking a little goes under it
    front = Image.new("L", (W, H), 255)
    fd = ImageDraw.Draw(front)
    for x in cols:
        fd.line((x, water[x] - 1, x, H), fill=0)
    front = front.filter(ImageFilter.GaussianBlur(1))

    out = src.parent / ".live" / src.stem
    out.mkdir(parents=True, exist_ok=True)
    figure.save(out / "figure.png", compress_level=3)
    plate.save(out / "plate.png", compress_level=3)
    front.save(out / "front.png", compress_level=3)
    meta = {"size": [W, H], "horizon": horizon, "pivot": list(pivot), "made": int(time.time())}
    if sunlayer:
        sunlayer.save(out / "sun.png", compress_level=3)
        meta["sun"] = [sun[0], sun[1], sun[3]]
    else:
        (out / "sun.png").unlink(missing_ok=True)
    (out / "live.json").write_text(json.dumps(meta) + "\n")
    print(out)


if __name__ == "__main__":
    main()
