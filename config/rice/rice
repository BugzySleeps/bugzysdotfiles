#!/usr/bin/env python3
"""rice — switch the whole desktop theme (Hyprland, waybar, kitty, alacritty, wofi, wallpaper).

  rice               pick a theme with wofi
  rice <name>        switch to <name>
  rice next|prev     cycle through themes
  rice list          list themes (* = current)
  rice reload        re-render the current theme (after editing a template)
  rice wallpaper     start the current theme's wallpaper (for autostart)

Themes live in ~/.config/rice/themes/<name>/theme.toml.
Templates live in ~/.config/rice/templates/, mirroring paths under ~/.config.
Placeholders look like {{colors.accent}} with optional filters: {{colors.accent|hex}}.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config"
RICE = CONFIG / "rice"
THEMES = RICE / "themes"
TEMPLATES = RICE / "templates"
CURRENT = RICE / "current"


# ── colour filters ──────────────────────────────────────────────────────────
def _hex(c):
    """'#rrggbb' or '#rrggbbaa' -> 'rrggbbaa'"""
    c = c.lstrip("#")
    return c if len(c) == 8 else c + "ff"


FILTERS = {
    "hex":  lambda c: _hex(c)[:6],                                   # rrggbb
    "rgb":  lambda c: ", ".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),
    "rgba": lambda c: f"rgba({_hex(c)})",                            # hyprland rgba(rrggbbaa)
    "argb": lambda c: "0x" + _hex(c)[6:] + _hex(c)[:6],              # hyprland 0xaarrggbb
    "0x":   lambda c: "0x" + _hex(c)[:6],                            # alacritty / hyprland 0xrrggbb
    "ansi": lambda c: ";".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),  # r;g;b for escapes
    "hyprlist": lambda cs: ", ".join(f'"rgba({_hex(c)})"' for c in cs),
    "str":  lambda v: str(v),
}


def lookup(theme, key):
    val = theme
    for part in key.split("."):
        val = val[part]
    return val


def render(text, theme, src):
    def sub(m):
        key, _, filt = m.group(1).strip().partition("|")
        try:
            val = lookup(theme, key)
        except KeyError:
            sys.exit(f"rice: {src}: theme '{theme['name']}' has no key '{key}'")
        return FILTERS[filt](val) if filt else str(val)
    return re.sub(r"\{\{([^}]+)\}\}", sub, text)


# ── themes ──────────────────────────────────────────────────────────────────
def themes():
    return sorted(p.name for p in THEMES.iterdir() if (p / "theme.toml").is_file())


def current():
    try:
        return CURRENT.read_text().strip()
    except FileNotFoundError:
        return None


def luminance(c):
    r, g, b = (int(_hex(c)[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def lock_clock(theme):
    """A theme colour dark enough to read on hyprlock's white Larry: the first
    dark one of accent / accent2 / border / fg, else the darkest of the palette."""
    c = theme.get("colors", {})
    picks = [c[k] for k in ("accent", "accent2", "border", "fg") if k in c]
    dark = [p for p in picks if luminance(p) < 0.32]
    return dark[0] if dark else min(c.values(), key=luminance)


SHAPE_DOTS = ", ".join(f"~/.config/hypr/dots/{n}.png" for n in
                       ("diamond", "triangle", "square", "arch", "pill", "circle", "cookie", "clover"))


def shape_dots():
    """Password dots for hyprlock: random shapes with patches/hyprlock-shape-dots.patch applied,
    else hyprlock's plain dots (an unpatched hyprlock would print the image paths as text).
    The patch adds the "img:" prefix; stock hyprlock has no such string."""
    exe = shutil.which("hyprlock")
    try:
        return "img:" + SHAPE_DOTS if exe and b"img:" in Path(exe).read_bytes() else ""
    except OSError:
        return ""


def load(name):
    path = THEMES / name / "theme.toml"
    if not path.is_file():
        sys.exit(f"rice: no theme '{name}'. Available: {', '.join(themes())}")
    with open(path, "rb") as f:
        theme = tomllib.load(f)
    theme["name"] = name
    theme["dir"] = str(THEMES / name)
    theme.setdefault("term", {}).setdefault("opacity", 0.4)   # kitty background_opacity
    theme["lock_clock"] = lock_clock(theme)
    theme["lock_dots"] = shape_dots()
    theme.setdefault("hypr", {}).setdefault("border_size", 3)
    # window blur on/off; stored as a Lua literal so the template can drop it straight in
    theme["hypr"]["blur"] = "true" if theme["hypr"].get("blur", True) else "false"
    theme.setdefault("waybar", True)                          # false: no bar at all for this theme
    theme.setdefault("fastfetch", {}).setdefault("logo", "")   # fastfetch logo name; "" = the distro's own
    theme.setdefault("mouse", theme.get("colors", {}).get("accent", "#ffffff"))  # mouse LED (mouse-color)
    wp = theme.get("wallpaper", "")
    if wp:
        wp = Path(os.path.expanduser(wp))
        theme["wallpaper"] = str(wp if wp.is_absolute() else THEMES / name / wp)
    return theme


# ── apply ───────────────────────────────────────────────────────────────────
def sh(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        return [m["name"] for m in json.loads(out)]
    except (json.JSONDecodeError, KeyError):
        return []


def running(pattern):
    return subprocess.run(["pgrep", "-f", pattern], stdout=subprocess.DEVNULL).returncode == 0


def set_wallpaper(theme):
    """Image wallpapers go through hyprpaper; `wallpaper_cmd` runs a live wallpaper program instead."""
    # stop any live wallpaper started by a theme (matched by program name)
    for n in themes():
        cmd = load(n).get("wallpaper_cmd")
        if cmd:
            prog = re.escape(os.path.basename(shlex.split(cmd)[0]))
            # also matches scripts, whose command line starts with their interpreter
            sh("pkill", "-f", rf"^(\S*/)?(python3?|bash|sh) \S*/{prog}( |$)|^(\S*/)?{prog}( |$)")

    if theme.get("wallpaper_cmd"):
        sh("pkill", "-x", "hyprpaper")
        spawn(*map(os.path.expanduser, shlex.split(theme["wallpaper_cmd"])))
        return

    if not theme.get("wallpaper"):
        return
    wp, mons = theme["wallpaper"], monitors()
    blocks = "".join(f"wallpaper {{\n    monitor = {m}\n    path = {wp}\n    fit_mode = cover\n}}\n"
                     for m in mons or [""])
    (CONFIG / "hypr/hyprpaper.conf").write_text(blocks + "splash = false\n")
    if running("^hyprpaper"):
        for m in mons or [""]:
            sh("hyprctl", "hyprpaper", "wallpaper", f"{m},{wp},cover")
    else:
        spawn("hyprpaper")


def apply(name):
    theme = load(name)

    # 1. render every template into ~/.config (themes/<name>/templates/ overrides a file)
    srcs = {}
    for root in (TEMPLATES, THEMES / name / "templates"):
        if root.is_dir():
            srcs.update((p.relative_to(root), p) for p in root.rglob("*") if p.is_file())
    for rel, src in srcs.items():
        dest = CONFIG / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(render(src.read_text(), theme, src))

    # 2. hyprlock art (squiggly box, password-dot shapes) in this theme's colours
    lockenv = {**os.environ, "LOCK_LINE": theme["colors"]["accent"], "LOCK_FILL": theme["colors"]["bg1"],
               "LOCK_DOT": theme["colors"]["fg"]}
    for script in ("lockart.py", "lockdots.py"):
        if (CONFIG / "hypr" / script).is_file():
            subprocess.Popen(["python3", script], cwd=CONFIG / "hypr", env=lockenv, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)

    # mouse LEDs via ratbag/Piper (in the background: ratbagctl takes a moment)
    spawn(str(RICE / "mouse-color"), theme["mouse"])

    # 3. wallpaper
    set_wallpaper(theme)

    CURRENT.write_text(name + "\n")

    # 4. live reloads
    sh("hyprctl", "reload")
    disabled = CONFIG / "waybar" / "disabled"    # toggle.sh won't open the bar while this exists
    if not theme["waybar"]:
        disabled.touch()
        sh("pkill", "-x", "waybar")
    else:
        disabled.unlink(missing_ok=True)
        if running("^waybar"):                   # keep it hidden if it was hidden
            sh("pkill", "-x", "waybar")
            spawn("waybar")
    sh("pkill", "-USR1", "-x", "kitty")          # kitty re-reads its config on SIGUSR1
    if running("^mako"):
        sh("makoctl", "reload")
    elif shutil.which("mako"):
        spawn("mako")
    # alacritty and wofi pick up changes on their own

    if shutil.which("notify-send"):
        spawn("timeout", "3", "notify-send", "-a", "rice", "Rice switched", name)
    print(f"rice: switched to {name}")


def screen_height():
    """Logical height of the focused monitor (900 if hyprctl can't tell us)."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        m = next((m for m in json.loads(out) if m.get("focused")), None)
        return int(m["height"] / m.get("scale", 1)) if m else 900
    except (json.JSONDecodeError, KeyError, TypeError, ValueError):
        return 900


def pick():
    cur = current()
    names = themes()
    menu = "\n".join(f"{n}  (current)" if n == cur else n for n in names)
    # fit every theme if there's room, otherwise cap at 60% of the screen; wofi scrolls the rest
    height = min(60 + 42 * len(names), int(screen_height() * 0.6))
    r = subprocess.run(["wofi", "--dmenu", "--prompt", "rice", "--width", "320",
                        "--height", str(height), "--cache-file", "/dev/null"],
                       input=menu, capture_output=True, text=True)
    choice = r.stdout.strip().split()[0] if r.stdout.strip() else ""
    if choice:
        apply(choice)


def cycle(step):
    names = themes()
    cur = current()
    i = names.index(cur) if cur in names else -1
    apply(names[(i + step) % len(names)])


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        pick()
    elif arg in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif arg == "list":
        cur = current()
        for n in themes():
            print(("* " if n == cur else "  ") + n)
    elif arg == "next":
        cycle(1)
    elif arg == "prev":
        cycle(-1)
    elif arg == "wallpaper":                    # used by Hyprland autostart
        name = current()
        if name:
            set_wallpaper(load(name))
        else:
            spawn("hyprpaper")
    elif arg == "reload":
        apply(current() or sys.exit("rice: no current theme"))
    else:
        apply(arg)


if __name__ == "__main__":
    main()
