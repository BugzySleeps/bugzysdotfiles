#!/usr/bin/env python3
"""rice — switch the whole desktop theme (Hyprland, waybar, kitty, alacritty, wofi, wallpaper).

  rice               pick a theme with wofi
  rice <name>        switch to <name>
  rice next|prev     cycle through themes
  rice list          list themes (* = current)
  rice reload        re-render the current theme (after editing a template)
  rice wallpaper     start the current theme's wallpaper (for autostart)

Themes live in ~/.config/rice/themes/<name>/theme.toml.
Templates live in ~/.config/rice/templates/, mirroring paths under ~/.config.
Placeholders look like {{colors.accent}} with optional filters: {{colors.accent|hex}}.
"""
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config"
RICE = CONFIG / "rice"
THEMES = RICE / "themes"
TEMPLATES = RICE / "templates"
CURRENT = RICE / "current"


# ── colour filters ──────────────────────────────────────────────────────────
def _hex(c):
    """'#rrggbb' or '#rrggbbaa' -> 'rrggbbaa'"""
    c = c.lstrip("#")
    return c if len(c) == 8 else c + "ff"


FILTERS = {
    "hex":  lambda c: _hex(c)[:6],                                   # rrggbb
    "rgb":  lambda c: ", ".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),
    "rgba": lambda c: f"rgba({_hex(c)})",                            # hyprland rgba(rrggbbaa)
    "argb": lambda c: "0x" + _hex(c)[6:] + _hex(c)[:6],              # hyprland 0xaarrggbb
    "0x":   lambda c: "0x" + _hex(c)[:6],                            # alacritty / hyprland 0xrrggbb
    "ansi": lambda c: ";".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),  # r;g;b for escapes
    "hyprlist": lambda cs: ", ".join(f'"rgba({_hex(c)})"' for c in cs),
    "str":  lambda v: str(v),
}


def lookup(theme, key):
    val = theme
    for part in key.split("."):
        val = val[part]
    return val


def render(text, theme, src):
    def sub(m):
        key, _, filt = m.group(1).strip().partition("|")
        try:
            val = lookup(theme, key)
        except KeyError:
            sys.exit(f"rice: {src}: theme '{theme['name']}' has no key '{key}'")
        return FILTERS[filt](val) if filt else str(val)
    return re.sub(r"\{\{([^}]+)\}\}", sub, text)


# ── themes ──────────────────────────────────────────────────────────────────
def themes():
    return sorted(p.name for p in THEMES.iterdir() if (p / "theme.toml").is_file())


def current():
    try:
        return CURRENT.read_text().strip()
    except FileNotFoundError:
        return None


def load(name):
    path = THEMES / name / "theme.toml"
    if not path.is_file():
        sys.exit(f"rice: no theme '{name}'. Available: {', '.join(themes())}")
    with open(path, "rb") as f:
        theme = tomllib.load(f)
    theme["name"] = name
    theme["dir"] = str(THEMES / name)
    wp = theme.get("wallpaper", "")
    if wp:
        wp = Path(os.path.expanduser(wp))
        theme["wallpaper"] = str(wp if wp.is_absolute() else THEMES / name / wp)
    return theme


# ── apply ───────────────────────────────────────────────────────────────────
def sh(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        return [m["name"] for m in json.loads(out)]
    except (json.JSONDecodeError, KeyError):
        return []


def running(pattern):
    return subprocess.run(["pgrep", "-f", pattern], stdout=subprocess.DEVNULL).returncode == 0


def set_wallpaper(theme):
    """Image wallpapers go through hyprpaper; `wallpaper_cmd` runs a live wallpaper program instead."""
    # stop any live wallpaper started by a theme (matched by program name)
    for n in themes():
        cmd = load(n).get("wallpaper_cmd")
        if cmd:
            prog = re.escape(os.path.basename(shlex.split(cmd)[0]))
            sh("pkill", "-f", rf"^(\S*/)?{prog}( |$)")

    if theme.get("wallpaper_cmd"):
        sh("pkill", "-x", "hyprpaper")
        spawn(*shlex.split(os.path.expanduser(theme["wallpaper_cmd"])))
        return

    if not theme.get("wallpaper"):
        return
    wp, mons = theme["wallpaper"], monitors()
    blocks = "".join(f"wallpaper {{\n    monitor = {m}\n    path = {wp}\n    fit_mode = cover\n}}\n"
                     for m in mons or [""])
    (CONFIG / "hypr/hyprpaper.conf").write_text(blocks + "splash = false\n")
    if running("^hyprpaper"):
        for m in mons or [""]:
            sh("hyprctl", "hyprpaper", "wallpaper", f"{m},{wp},cover")
    else:
        spawn("hyprpaper")


def apply(name):
    theme = load(name)

    # 1. render every template into ~/.config
    for src in TEMPLATES.rglob("*"):
        if src.is_dir():
            continue
        dest = CONFIG / src.relative_to(TEMPLATES)
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(render(src.read_text(), theme, src))

    # 2. wallpaper
    set_wallpaper(theme)

    CURRENT.write_text(name + "\n")

    # 3. live reloads
    sh("hyprctl", "reload")
    if running("^waybar"):                       # keep it hidden if it was hidden
        sh("pkill", "-x", "waybar")
        spawn("waybar")
    sh("pkill", "-USR1", "-x", "kitty")          # kitty re-reads its config on SIGUSR1
    if running("^mako"):
        sh("makoctl", "reload")
    elif shutil.which("mako"):
        spawn("mako")
    # alacritty and wofi pick up changes on their own

    if shutil.which("notify-send"):
        spawn("timeout", "3", "notify-send", "-a", "rice", "Rice switched", name)
    print(f"rice: switched to {name}")


def pick():
    cur = current()
    names = themes()
    menu = "\n".join(f"{n}  (current)" if n == cur else n for n in names)
    r = subprocess.run(["wofi", "--dmenu", "--prompt", "rice", "--width", "320",
                        "--height", str(60 + 42 * len(names)), "--cache-file", "/dev/null"],
                       input=menu, capture_output=True, text=True)
    choice = r.stdout.strip().split()[0] if r.stdout.strip() else ""
    if choice:
        apply(choice)


def cycle(step):
    names = themes()
    cur = current()
    i = names.index(cur) if cur in names else -1
    apply(names[(i + step) % len(names)])


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        pick()
    elif arg in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif arg == "list":
        cur = current()
        for n in themes():
            print(("* " if n == cur else "  ") + n)
    elif arg == "next":
        cycle(1)
    elif arg == "prev":
        cycle(-1)
    elif arg == "wallpaper":                    # used by Hyprland autostart
        name = current()
        if name:
            set_wallpaper(load(name))
        else:
            spawn("hyprpaper")
    elif arg == "reload":
        apply(current() or sys.exit("rice: no current theme"))
    else:
        apply(arg)


if __name__ == "__main__":
    main()
