#!/usr/bin/env python3
"""rice — switch the whole desktop theme (Hyprland, waybar, kitty, alacritty, wofi, wallpaper).

  rice               pick a theme with wofi
  rice <name>        switch to <name>
  rice next|prev     cycle through themes
  rice list          list themes (* = current)
  rice list --json   every theme's name, description, wallpaper, palette and shell (for the Quickshell picker)
  rice reload        re-render the current theme (after editing a template)
  rice wallpaper     start the current theme's wallpaper (for autostart)
  rice pet           start the pet unless the current theme sets pet = false (for autostart)
  rice shell         start mako, or the current theme's Quickshell shell (for autostart)
  rice lock          lock the screen: the theme's Quickshell lock screen, else hyprlock
  rice lock --boot   the same, at login: the Quickshell lock opens with its intro
  rice wall <image>  use <image> as the wallpaper and recolour the theme from it (themes with wallpaper_picker)
  rice wall default  back to the theme's own wallpaper and colours
  rice accent <image|url>  for now, take the colours from an image (album art): the shell and the
                     window borders crossfade to it; the wallpaper and the theme stay as they are
                     (and the terminals); with --wall, the wallpaper too: one made from the cover's colours
  rice accent off    back to the theme's colours
  rice walls --json  the wallpapers on offer, each with the palette it would give (for the Quickshell picker)

Themes live in ~/.config/rice/themes/<name>/theme.toml.
A theme with wallpaper_picker = true lets you pick any image from wallpaper_dir (default ~/Pictures/wallpapers):
its palette is the theme's own, turned to the image's main hue (greys for a colourless image).
A theme with quickshell = "<config>" runs ~/.config/quickshell/<config> as its shell (bar,
notifications, launcher) instead of waybar + mako.
Templates live in ~/.config/rice/templates/, mirroring paths under ~/.config.
Placeholders look like {{colors.accent}} with optional filters: {{colors.accent|hex}}.
"""
import colorsys
import json
import math
import os
import re
import shlex
import shutil
import subprocess
import sys
import time
import tomllib
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config"
RICE = CONFIG / "rice"
THEMES = RICE / "themes"
TEMPLATES = RICE / "templates"
CURRENT = RICE / "current"
WALLSTATE = HOME / ".local/state/rice"       # <theme>.json: the wallpaper picked for a theme, and its tone
TONECACHE = HOME / ".cache/rice/tones.json"
PALETTE = WALLSTATE / "palette.json"            # the current theme's colours + wallpaper, read live by the Quickshell shell


# ── colour filters ──────────────────────────────────────────────────────────
def _hex(c):
    """'#rrggbb' or '#rrggbbaa' -> 'rrggbbaa'"""
    c = c.lstrip("#")
    return c if len(c) == 8 else c + "ff"


FILTERS = {
    "hex":  lambda c: _hex(c)[:6],                                   # rrggbb
    "rgb":  lambda c: ", ".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),
    "rgba": lambda c: f"rgba({_hex(c)})",                            # hyprland rgba(rrggbbaa)
    "argb": lambda c: "0x" + _hex(c)[6:] + _hex(c)[:6],              # hyprland 0xaarrggbb
    "0x":   lambda c: "0x" + _hex(c)[:6],                            # alacritty / hyprland 0xrrggbb
    "ansi": lambda c: ";".join(str(int(_hex(c)[i:i + 2], 16)) for i in (0, 2, 4)),  # r;g;b for escapes
    "hyprlist": lambda cs: ", ".join(f'"rgba({_hex(c)})"' for c in cs),
    "str":  lambda v: str(v),
}


def lookup(theme, key):
    val = theme
    for part in key.split("."):
        val = val[part]
    return val


def render(text, theme, src):
    def sub(m):
        key, _, filt = m.group(1).strip().partition("|")
        try:
            val = lookup(theme, key)
        except KeyError:
            sys.exit(f"rice: {src}: theme '{theme['name']}' has no key '{key}'")
        return FILTERS[filt](val) if filt else str(val)
    return re.sub(r"\{\{([^}]+)\}\}", sub, text)


# ── themes ──────────────────────────────────────────────────────────────────
def themes():
    return sorted(p.name for p in THEMES.iterdir() if (p / "theme.toml").is_file())


def current():
    try:
        return CURRENT.read_text().strip()
    except FileNotFoundError:
        return None


def luminance(c):
    r, g, b = (int(_hex(c)[i:i + 2], 16) / 255 for i in (0, 2, 4))
    return 0.2126 * r + 0.7152 * g + 0.0722 * b


def lock_clock(theme):
    """A theme colour dark enough to read on hyprlock's white Larry: the first
    dark one of accent / accent2 / border / fg, else the darkest of the palette."""
    c = theme.get("colors", {})
    picks = [c[k] for k in ("accent", "accent2", "border", "fg") if k in c]
    dark = [p for p in picks if luminance(p) < 0.32]
    return dark[0] if dark else min(c.values(), key=luminance)


SHAPE_DOTS = ", ".join(f"~/.config/hypr/dots/{n}.png" for n in
                       ("diamond", "triangle", "square", "arch", "pill", "circle", "cookie", "clover"))


def shape_dots():
    """Password dots for hyprlock: random shapes with patches/hyprlock-shape-dots.patch applied,
    else hyprlock's plain dots (an unpatched hyprlock would print the image paths as text).
    The patch adds the "img:" prefix; stock hyprlock has no such string."""
    exe = shutil.which("hyprlock")
    try:
        return "img:" + SHAPE_DOTS if exe and b"img:" in Path(exe).read_bytes() else ""
    except OSError:
        return ""


def load(name, picked=True):
    """picked=False: the theme as written, ignoring a wallpaper picked with `rice wall`."""
    path = THEMES / name / "theme.toml"
    if not path.is_file():
        sys.exit(f"rice: no theme '{name}'. Available: {', '.join(themes())}")
    with open(path, "rb") as f:
        theme = tomllib.load(f)
    state = wall_state(name) if picked and theme.get("wallpaper_picker") else None
    if state and Path(state["path"]).is_file():
        theme["wallpaper"] = state["path"]
        recolour(theme, state["hue"], state["colour"])
    theme["name"] = name
    theme["dir"] = str(THEMES / name)
    theme.setdefault("term", {}).setdefault("opacity", 0.4)   # kitty background_opacity
    theme["lock_clock"] = lock_clock(theme)
    theme["lock_dots"] = shape_dots()
    theme.setdefault("hypr", {}).setdefault("border_size", 3)
    # window blur on/off; stored as a Lua literal so the template can drop it straight in
    theme["hypr"]["blur"] = "true" if theme["hypr"].get("blur", True) else "false"
    theme.setdefault("waybar", True)                          # false: no bar at all for this theme
    theme.setdefault("pet", True)                             # false: no hyprland-pets for this theme
    theme.setdefault("quickshell", "")                        # a Quickshell config to run as this theme's shell
    theme.setdefault("fastfetch", {}).setdefault("logo", "")   # fastfetch logo name; "" = the distro's own
    theme.setdefault("mouse", theme.get("colors", {}).get("accent", "#ffffff"))  # mouse LED (mouse-color)
    wp = theme.get("wallpaper", "")
    if wp:
        wp = Path(os.path.expanduser(wp))
        theme["wallpaper"] = str(wp if wp.is_absolute() else THEMES / name / wp)
    return theme


# ── wallpaper colours ───────────────────────────────────────────────────────
def wall_state(name):
    try:
        return json.loads((WALLSTATE / f"{name}.json").read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return None


def tone(image):
    """An image's main colour: (hue 0-1, colour 0-1). Colourful pixels vote for their hue, weighted by
    how saturated and bright they are; colour 0 means it has none to speak of (greys)."""
    try:
        cache = json.loads(TONECACHE.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        cache = {}
    key = f"{image}:{os.path.getmtime(image)}"
    if key in cache:
        return tuple(cache[key])

    from PIL import Image
    im = Image.open(image).convert("RGB")
    im.thumbnail((96, 96))
    bins, sats, n = [0.0] * 36, [0.0] * 36, 0
    for r, g, b in (im.get_flattened_data() if hasattr(im, "get_flattened_data") else im.getdata()):
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        n += 1
        if s < 0.2 or v < 0.18:
            continue
        w = s * s * v
        bins[int(h * 36) % 36] += w
        sats[int(h * 36) % 36] += w * s
    smooth = [bins[i - 1] + 2 * bins[i] + bins[(i + 1) % 36] for i in range(36)]
    peak = max(range(36), key=smooth.__getitem__)
    if sum(bins) / max(n, 1) < 0.004:             # hardly any colourful pixels
        result = (0.0, 0.0)
    else:
        x = y = w = ws = 0.0
        for j in (peak - 1, peak, peak + 1):
            j %= 36
            a = (j + 0.5) / 36 * 2 * math.pi
            x, y, w, ws = x + bins[j] * math.cos(a), y + bins[j] * math.sin(a), w + bins[j], ws + sats[j]
        result = (round(math.atan2(y, x) / (2 * math.pi) % 1, 4), round(min(1.0, ws / w / 0.45), 3))
    cache[key] = result
    TONECACHE.parent.mkdir(parents=True, exist_ok=True)
    TONECACHE.write_text(json.dumps(cache))
    return result


def recolour(theme, hue, colour):
    """Turn every colour in the theme to `hue`, keeping how light and how saturated each one is
    (scaled by `colour`; 0 = greys). Blacks and greys stay as they are. Lightness is matched
    afterwards, so a blue isn't darker than the green it replaces."""
    base = colorsys.rgb_to_hsv(*(int(_hex(theme["colors"]["accent"])[i:i + 2], 16) / 255 for i in (0, 2, 4)))[0]

    def turn(c):
        if not isinstance(c, str) or not re.fullmatch(r"#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", c):
            return c
        rgb = [int(c[i:i + 2], 16) / 255 for i in (1, 3, 5)]
        h, s, v = colorsys.rgb_to_hsv(*rgb)
        if s < 0.06:
            return c
        h, s = (h + hue - base) % 1, s * colour
        out = colorsys.hsv_to_rgb(h, s, v)
        want, got = luminance(c), luminance("#%02x%02x%02x" % tuple(round(x * 255) for x in out))
        if got > 0 and got < want:
            v = min(1.0, v * math.sqrt(want / got))
            out = colorsys.hsv_to_rgb(h, s, v)
        return "#%02x%02x%02x" % tuple(round(x * 255) for x in out) + c[7:]

    def walk(x):
        if isinstance(x, dict):
            return {k: walk(v) for k, v in x.items()}
        if isinstance(x, list):
            return [walk(v) for v in x]
        return turn(x)

    for section in ("colors", "hypr", "term", "fastfetch"):
        if section in theme:
            theme[section] = walk(theme[section])
    if "mouse" in theme:
        theme["mouse"] = turn(theme["mouse"])


def wall_dir(theme):
    return Path(os.path.expanduser(theme.get("wallpaper_dir", "~/Pictures/wallpapers")))


def walls(name):
    """The picker's list: the theme's own wallpaper first, then every image in wallpaper_dir."""
    raw = load(name, picked=False)
    state = wall_state(name)
    picked = state["path"] if state and Path(state["path"]).is_file() else None
    out = [{"name": "default", "label": f"{name} default", "path": raw.get("wallpaper", ""), "own": True,
            "current": picked is None, "colors": raw["colors"], "term": palette_term(raw)}]
    d = wall_dir(raw)
    images = sorted(p for p in d.iterdir() if p.suffix.lower() in (".png", ".jpg", ".jpeg", ".webp")) if d.is_dir() else []
    for img in images:
        hue, colour = tone(img)
        t = load(name, picked=False)
        recolour(t, hue, colour)
        out.append({"name": str(img), "label": img.stem, "path": str(img), "own": False,
                    "current": str(img) == picked, "hue": round(hue * 360), "mono": colour == 0,
                    "colors": t["colors"], "term": palette_term(t)})
    return out


def palette_term(t):
    term = t.get("term", {})
    return [term[f"color{i}"] for i in range(1, 7) if f"color{i}" in term]


def set_wall(arg):
    name = current() or sys.exit("rice: no current theme")
    theme = load(name, picked=False)
    if not theme.get("wallpaper_picker"):
        sys.exit(f"rice: {name} doesn't take picked wallpapers (wallpaper_picker = true in its theme.toml)")
    statefile = WALLSTATE / f"{name}.json"
    if arg == "default":
        statefile.unlink(missing_ok=True)
        label = "default"
    else:
        img = Path(os.path.expanduser(arg)).resolve()
        if not img.is_file():
            sys.exit(f"rice: no image {img}")
        hue, colour = tone(img)
        WALLSTATE.mkdir(parents=True, exist_ok=True)
        statefile.write_text(json.dumps({"path": str(img), "hue": hue, "colour": colour}) + "\n")
        label = img.stem
    apply(name, note=False)                      # the picker / the wallpaper itself shows it changed
    print(f"rice: wallpaper {label}")


# ── apply ───────────────────────────────────────────────────────────────────
def sh(*cmd):
    subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def spawn(*cmd):
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     stdin=subprocess.DEVNULL, start_new_session=True)


def monitors():
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        return [m["name"] for m in json.loads(out)]
    except (json.JSONDecodeError, KeyError):
        return []


def running(pattern):
    return subprocess.run(["pgrep", "-f", pattern], stdout=subprocess.DEVNULL).returncode == 0


PET = HOME / ".local" / "bin" / "hyprland-pets"
PET_PROC = "hyprland-pets/src/larry.py"


def set_pet(theme):
    """Start or stop hyprland-pets per theme (the launcher does nothing if one is already running)."""
    if not theme["pet"]:
        sh("pkill", "-f", PET_PROC)
    elif PET.exists():
        spawn(str(PET))


def set_shell(theme):
    """Quickshell themes bring their own bar and notification daemon; every other theme gets mako.
    Only one thing can own org.freedesktop.Notifications, so the other one is stopped first."""
    want = theme["quickshell"]
    for n in themes():
        other = load(n)["quickshell"]
        if other and other != want:
            sh("qs", "kill", "-c", other)
    if want:
        sh("pkill", "-x", "mako")
        spawn("qs", "-c", want, "-n")              # -n: does nothing if it's already running
    elif running("^mako"):
        sh("makoctl", "reload")
    elif shutil.which("mako"):
        spawn("mako")


def set_wallpaper(theme):
    """Image wallpapers go through hyprpaper; `wallpaper_cmd` runs a live wallpaper program instead."""
    # stop any live wallpaper started by a theme (matched by program name)
    for n in themes():
        cmd = load(n).get("wallpaper_cmd")
        if cmd:
            prog = re.escape(os.path.basename(shlex.split(cmd)[0]))
            # also matches scripts, whose command line starts with their interpreter
            sh("pkill", "-f", rf"^(\S*/)?(python3?|bash|sh) \S*/{prog}( |$)|^(\S*/)?{prog}( |$)")

    if theme.get("wallpaper_by_shell"):          # the Quickshell shell draws it (and fades between them)
        sh("pkill", "-x", "hyprpaper")
        return

    if theme.get("wallpaper_cmd"):
        sh("pkill", "-x", "hyprpaper")
        spawn(*map(os.path.expanduser, shlex.split(theme["wallpaper_cmd"])))
        return

    if not theme.get("wallpaper"):
        return
    wp, mons = theme["wallpaper"], monitors()
    blocks = "".join(f"wallpaper {{\n    monitor = {m}\n    path = {wp}\n    fit_mode = cover\n}}\n"
                     for m in mons or [""])
    (CONFIG / "hypr/hyprpaper.conf").write_text(blocks + "splash = false\n")
    if running("^hyprpaper"):
        for m in mons or [""]:
            sh("hyprctl", "hyprpaper", "wallpaper", f"{m},{wp},cover")
    else:
        spawn("hyprpaper")


def screen_size():
    """Logical size of the focused monitor (1920x1080 if hyprctl can't tell us)."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        m = next((m for m in json.loads(out) if m.get("focused")), None)
        return round(m["width"] / m.get("scale", 1)), round(m["height"] / m.get("scale", 1))
    except (json.JSONDecodeError, KeyError, TypeError, ValueError, StopIteration):
        return 1920, 1080


ARTWALLS = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "rice-artwall"


def cover_colours(cover):
    """A cover's colours, the ones it's made of most first; greys only if that's all it has."""
    small = cover.copy()
    small.thumbnail((64, 64))
    q = small.quantize(10)
    pal = q.getpalette()
    found = []
    for n, i in sorted(q.getcolors(), reverse=True):
        h, s, v = colorsys.rgb_to_hsv(*(x / 255 for x in pal[i * 3:i * 3 + 3]))
        found.append((n, h, s, v))
    vivid = [c for c in found if c[2] > 0.22 and c[3] > 0.16]
    picks = sorted(vivid, key=lambda c: -c[0] * (0.4 + c[2])) if vivid else found
    out = []
    for c in picks:                               # skip near-repeats of a hue already taken
        if all(min(abs(c[1] - o[1]), 1 - abs(c[1] - o[1])) > 0.04 or abs(c[3] - o[3]) > 0.3 for o in out):
            out.append(c)
    return (out or found)[:4]


def art_wall(img, grey=False):
    """The backdrop for the playing track's wallpaper, in the cover's colours: a dark ground with soft glows,
    and a vignette (grey: a black-and-white cover, so greys and white light). It's all soft, so it's made at a quarter of the screen's size (quick: it's made while the
    track starts) and scaled up when shown. The shell draws the rest on top (desktop/Wallpaper.qml): grain,
    the moving design (waves, aurora, drips or a glass orb, shaders/artwall.frag), the cover and the song.
    Made once per cover and screen size, in $XDG_RUNTIME_DIR."""
    import hashlib
    import random
    W, H = (max(1, n // 4) for n in screen_size())
    key = hashlib.sha1(f"{img}|{os.path.getmtime(img)}|{W}x{H}|4{'g' if grey else ''}".encode()).hexdigest()[:16]
    out = ARTWALLS / f"{key}.png"
    if out.is_file():
        return out
    from PIL import Image, ImageChops, ImageDraw, ImageFilter
    cover = Image.open(img).convert("RGB")
    cols = cover_colours(cover)
    rnd = random.Random(key)

    def rgb(h, s, v):
        s = 0 if grey else s
        return tuple(round(x * 255) for x in colorsys.hsv_to_rgb(h % 1, max(0.0, min(1.0, s)), max(0.0, min(1.0, v))))

    # the ground: dark, in the cover's main colour, with two soft glows (drawn small and blurred, then scaled up)
    w, h = max(1, W // 2), max(1, H // 2)
    h0, s0 = cols[0][1], cols[0][2]
    im = Image.new("RGB", (w, h), rgb(h0, s0 * 0.8, 0.05))
    for j, (x, y, r, a) in enumerate([(0.22, 0.50, 0.55, 150), (0.86, 0.12, 0.62, 120)]):
        n, ch, cs, cv = cols[j % len(cols)]
        x, y = x + rnd.uniform(-0.04, 0.04), y + rnd.uniform(-0.04, 0.04)
        rx, ry = r * w * 0.5, r * h * 0.7
        layer = Image.new("L", (w, h), 0)
        ImageDraw.Draw(layer).ellipse((x * w - rx, y * h - ry, x * w + rx, y * h + ry), fill=a)
        layer = layer.filter(ImageFilter.GaussianBlur(min(w, h) * 0.16))
        im = Image.composite(Image.new("RGB", (w, h), rgb(ch, 0.2 + cs * 0.8, 0.35 + 0.25 * cv)), im, layer)
    im = im.resize((W, H), Image.BICUBIC).filter(ImageFilter.GaussianBlur(1))
    # vignette
    vig = Image.new("L", (w, h), 255)
    ImageDraw.Draw(vig).ellipse((-w * 0.2, -h * 0.25, w * 1.2, h * 1.25), fill=0)
    vig = vig.filter(ImageFilter.GaussianBlur(min(w, h) * 0.12)).resize((W, H), Image.BICUBIC)
    im = Image.composite(Image.new("RGB", (W, H), (0, 0, 0)), im, vig.point(lambda p: p * 0.7))
    ARTWALLS.mkdir(parents=True, exist_ok=True)
    for old in sorted(ARTWALLS.glob("*.png"), key=os.path.getmtime)[:-8]:   # keep the last few
        old.unlink(missing_ok=True)
    tmp = out.with_suffix(".tmp.png")
    im.save(tmp, compress_level=1)
    tmp.replace(out)
    return out


def render_some(theme, rels):
    """Re-render just these templates (paths under ~/.config); a theme's own copy wins."""
    for rel in rels:
        for root in (THEMES / theme["name"] / "templates", TEMPLATES):
            src = root / rel
            if src.is_file():
                (CONFIG / rel).write_text(render(src.read_text(), theme, src))
                break


def accent(arg, wall=False):
    """Recolour just the live parts (the Quickshell shell, through palette.json, Hyprland's borders and the
    terminals) from an image: cheap enough to follow the music, track by track. wall: the wallpaper too,
    one made from the image's colours (art_wall); the shell puts the cover and the song on it."""
    name = current() or sys.exit("rice: no current theme")
    theme = load(name)
    theme["home_wallpaper"] = theme.get("wallpaper", "")
    if arg != "off":
        img = arg
        if re.match(r"https?://", arg):          # art from the web (spotify, browsers): fetch it first
            img = str(Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp")) / "rice-accent-art")
            if subprocess.run(["curl", "-sfL", "-m", "8", "-o", img, arg]).returncode != 0:
                sys.exit("rice: couldn't fetch the art")
        img = img.removeprefix("file://")
        if not Path(img).is_file():
            sys.exit(f"rice: no image {img}")
        hue, colour = tone(img)
        recolour(theme, hue, colour)             # a colourless cover (colour 0): everything in greys
        if wall:
            theme["wallpaper"] = str(art_wall(img, grey=colour == 0))
            from PIL import Image
            cols = cover_colours(Image.open(img).convert("RGB"))
            # for the shell's moving design: each colour livelier and lighter, so it glows on the dark
            theme["art"] = {"cover": arg, "colors": ["#%02x%02x%02x" % tuple(round(x * 255) for x in colorsys.hsv_to_rgb(
                h, 0 if colour == 0 else min(1.0, 0.25 + s * 0.85), min(1.0, 0.6 + 0.35 * v))) for n, h, s, v in cols]}
    write_palette(theme)
    render_some(theme, [Path("kitty/rice.conf"), Path("alacritty/rice.toml"), Path("fastfetch/config.jsonc")])
    sh("pkill", "-USR1", "-x", "kitty")          # kitty re-reads its config; alacritty watches its own
    h = theme["hypr"]
    actives = ", ".join(f'"rgba({_hex(c)})"' for c in h["border_active"])
    sh("hyprctl", "eval", f'hl.config({{ general = {{ col = {{ active_border = {{ colors = {{ {actives} }}, angle = {h.get("border_angle", 0)} }}, '
                          f'inactive_border = "rgba({_hex(h["border_inactive"])})" }} }} }})')


def lock_screen(boot=False):
    """Lock with the theme's Quickshell lock screen. The flag file makes a shell that's still starting (at
    login) lock as soon as it's up, and one that crashes lock again when it restarts. If it isn't locked
    within 8 seconds, hyprlock locks instead, so this never leaves the session open."""
    name = current()
    qs = load(name)["quickshell"] if name else ""
    if qs:
        flag = WALLSTATE / "locked"
        flag.parent.mkdir(parents=True, exist_ok=True)
        flag.write_text("boot\n" if boot else "")    # a shell that's still starting reads this
        subprocess.run(["qs", "-c", qs, "ipc", "call", "lock", "boot" if boot else "lock"], capture_output=True)
        for _ in range(40):
            r = subprocess.run(["qs", "-c", qs, "ipc", "call", "lock", "isLocked"], capture_output=True, text=True)
            if r.stdout.strip() == "true":
                return
            time.sleep(0.2)
        flag.unlink(missing_ok=True)             # hyprlock has it now; a late shell shouldn't lock as well
    os.execvp("hyprlock", ["hyprlock"])


def write_palette(theme):
    """The colours and wallpaper as JSON, for shells that recolour live instead of reloading."""
    PALETTE.parent.mkdir(parents=True, exist_ok=True)
    data = {k: theme.get(k) for k in ("name", "wallpaper", "colors", "hypr", "term")}
    # with an album wallpaper up (accent --wall): the cover, and the wallpaper it stands in for
    data.update({k: theme[k] for k in ("art", "home_wallpaper") if k in theme})
    tmp = PALETTE.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=1) + "\n")
    tmp.replace(PALETTE)


def apply(name, note=None):
    """note: (title, body) for the notification; False for none."""
    theme = load(name)

    # 1. render every template into ~/.config (themes/<name>/templates/ overrides a file)
    srcs = {}
    for root in (TEMPLATES, THEMES / name / "templates"):
        if root.is_dir():
            srcs.update((p.relative_to(root), p) for p in root.rglob("*") if p.is_file())
    for rel, src in srcs.items():
        dest = CONFIG / rel
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(render(src.read_text(), theme, src))

    # the palette straight away: a Quickshell shell starts loading the new wallpaper while the rest happens
    write_palette(theme)

    # 2. hyprlock art (squiggly box, password-dot shapes) in this theme's colours
    lockenv = {**os.environ, "LOCK_LINE": theme["colors"]["accent"], "LOCK_FILL": theme["colors"]["bg1"],
               "LOCK_DOT": theme["colors"]["fg"]}
    for script in ("lockart.py", "lockdots.py"):
        if (CONFIG / "hypr" / script).is_file():
            subprocess.Popen(["python3", script], cwd=CONFIG / "hypr", env=lockenv, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=True)

    # mouse LEDs via ratbag/Piper (in the background: ratbagctl takes a moment)
    spawn(str(RICE / "mouse-color"), theme["mouse"])

    # 3. wallpaper and pet
    set_wallpaper(theme)
    set_pet(theme)

    CURRENT.write_text(name + "\n")

    # 4. live reloads (the palette went out first, so the shell's wallpaper wipe starts closer to when these change)
    sh("hyprctl", "reload")
    disabled = CONFIG / "waybar" / "disabled"    # toggle.sh won't open the bar while this exists
    if not theme["waybar"]:
        disabled.touch()
        sh("pkill", "-x", "waybar")
    else:
        disabled.unlink(missing_ok=True)
        if running("^waybar"):                   # keep it hidden if it was hidden
            sh("pkill", "-x", "waybar")
            spawn("waybar")
    sh("pkill", "-USR1", "-x", "kitty")          # kitty re-reads its config on SIGUSR1
    set_shell(theme)                             # mako, or the theme's Quickshell
    # alacritty and wofi pick up changes on their own

    if note is not False and shutil.which("notify-send"):
        spawn("timeout", "3", "notify-send", "-a", "rice", *(note or ("Rice switched", name)))
    print(f"rice: switched to {name}")


def screen_height():
    """Logical height of the focused monitor (900 if hyprctl can't tell us)."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True).stdout
        m = next((m for m in json.loads(out) if m.get("focused")), None)
        return int(m["height"] / m.get("scale", 1)) if m else 900
    except (json.JSONDecodeError, KeyError, TypeError, ValueError):
        return 900


def pick():
    cur = current()
    names = themes()
    menu = "\n".join(f"{n}  (current)" if n == cur else n for n in names)
    # fit every theme if there's room, otherwise cap at 60% of the screen; wofi scrolls the rest
    height = min(60 + 42 * len(names), int(screen_height() * 0.6))
    r = subprocess.run(["wofi", "--dmenu", "--prompt", "rice", "--width", "320",
                        "--height", str(height), "--cache-file", "/dev/null"],
                       input=menu, capture_output=True, text=True)
    choice = r.stdout.strip().split()[0] if r.stdout.strip() else ""
    if choice:
        apply(choice)


def describe(name):
    """What the Quickshell rice picker shows on a theme's card."""
    t = load(name)
    head = []                                   # the comment block at the top of theme.toml
    for line in (THEMES / name / "theme.toml").read_text().splitlines():
        if not line.startswith("#"):
            break
        head.append(line.lstrip("# ").rstrip())
    text = " ".join(head)
    cut = min((i for i in (text.find(":"), text.find(" — ")) if i > 0), default=-1)
    title, about = (text[:cut], text[cut:].lstrip(":— ")) if cut > 0 else ("", text)
    if len(title) > 40:                         # no "Name: description" / "Name — description" form
        title, about = "", text
    c, term = t.get("colors", {}), t.get("term", {})
    return {
        "name": name,
        "title": title.strip(),
        "about": about.strip(),
        "current": name == current(),
        "wallpaper": t.get("wallpaper", ""),
        "live": bool(t.get("wallpaper_cmd")),
        "shell": "quickshell" if t["quickshell"] else "waybar" if t["waybar"] else "none",
        "blur": t["hypr"]["blur"] == "true",
        "rounding": t["hypr"].get("rounding", 0),
        "opacity": term.get("opacity"),
        "colors": {k: c[k] for k in ("bg0", "bg1", "bg2", "bg3", "dim", "accent2", "accent", "fg", "bright") if k in c},
        "term": [term[f"color{i}"] for i in range(1, 7) if f"color{i}" in term],
    }


def cycle(step):
    names = themes()
    cur = current()
    i = names.index(cur) if cur in names else -1
    apply(names[(i + step) % len(names)])


def main():
    arg = sys.argv[1] if len(sys.argv) > 1 else None
    if arg is None:
        pick()
    elif arg in ("-h", "--help", "help"):
        print(__doc__.strip())
    elif arg == "accent":
        args = [a for a in sys.argv[2:] if a != "--wall"]
        accent(args[0] if args else sys.exit("usage: rice accent <image|url> [--wall] | off"), wall="--wall" in sys.argv)
    elif arg == "lock":
        lock_screen(boot="--boot" in sys.argv)
    elif arg == "wall":
        set_wall(sys.argv[2] if len(sys.argv) > 2 else sys.exit("usage: rice wall <image>|default"))
    elif arg == "walls" and "--json" in sys.argv:
        print(json.dumps(walls(current() or sys.exit("rice: no current theme"))))
    elif arg == "list" and "--json" in sys.argv:
        print(json.dumps([describe(n) for n in themes()]))
    elif arg == "list":
        cur = current()
        for n in themes():
            print(("* " if n == cur else "  ") + n)
    elif arg == "next":
        cycle(1)
    elif arg == "prev":
        cycle(-1)
    elif arg == "wallpaper":                    # used by Hyprland autostart
        name = current()
        if name:
            set_wallpaper(load(name))
        else:
            spawn("hyprpaper")
    elif arg == "pet":                          # used by Hyprland autostart
        name = current()
        set_pet(load(name) if name else {"pet": True})
    elif arg == "shell":                        # used by Hyprland autostart
        name = current()
        if name:
            write_palette(load(name))
            set_shell(load(name))
        elif shutil.which("mako"):
            spawn("mako")
    elif arg == "reload":
        apply(current() or sys.exit("rice: no current theme"))
    else:
        apply(arg)


if __name__ == "__main__":
    main()
