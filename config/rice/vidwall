#!/usr/bin/env python3
"""vidwall VIDEO [MPV_OPTS]: mpvpaper video wallpaper that pauses while a window is fullscreen.

mpvpaper's own -p/-s never trigger on Hyprland, so this watches Hyprland's event socket
and flips mpv's pause property over its IPC socket instead. A theme uses it as
    wallpaper_cmd = "~/.config/rice/vidwall ~/Videos/x.mp4 'no-audio loop'"
"""
import json
import os
import signal
import socket
import subprocess
import sys

video = os.path.expanduser(sys.argv[1])
opts = sys.argv[2] if len(sys.argv) > 2 else "no-audio loop"
runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
ipc = f"{runtime}/vidwall.sock"
events = f"{runtime}/hypr/{os.environ['HYPRLAND_INSTANCE_SIGNATURE']}/.socket2.sock"

mpv = subprocess.Popen(["mpvpaper", "-o", f"{opts} input-ipc-server={ipc}", "*", video],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def quit(*_):
    mpv.terminate()
    sys.exit(0)


signal.signal(signal.SIGTERM, quit)
signal.signal(signal.SIGINT, quit)


def hyprctl(what):
    out = subprocess.run(["hyprctl", what, "-j"], capture_output=True, text=True).stdout
    try:
        return json.loads(out)
    except json.JSONDecodeError:
        return []


def covered():
    """True when every monitor is showing a workspace with a fullscreen window."""
    full = {w["id"] for w in hyprctl("workspaces") if w.get("hasfullscreen")}
    shown = [m["activeWorkspace"]["id"] for m in hyprctl("monitors")]
    return bool(shown) and all(ws in full for ws in shown)


def set_pause(paused):
    try:
        with socket.socket(socket.AF_UNIX) as s:
            s.connect(ipc)
            s.sendall(json.dumps({"command": ["set_property", "pause", paused]}).encode() + b"\n")
        return True
    except OSError:
        return False  # mpv not up yet; retried on the next event/tick


# events after which the fullscreen state may have changed
WATCH = (b"fullscreen>>", b"workspace>>", b"focusedmon>>", b"openwindow>>",
         b"closewindow>>", b"movewindow>>", b"activespecial>>")

state = None
with socket.socket(socket.AF_UNIX) as hypr:
    hypr.connect(events)
    hypr.settimeout(3)
    buf = b""
    while mpv.poll() is None:
        try:
            chunk = hypr.recv(4096)
            if not chunk:
                break  # Hyprland exited
            buf += chunk
            *lines, buf = buf.split(b"\n")
            if not any(l.startswith(WATCH) for l in lines):
                continue
        except socket.timeout:
            if state is not None:
                continue  # idle tick: only needed until mpv's socket first answers
        want = covered()
        if want != state and set_pause(want):
            state = want
quit()
