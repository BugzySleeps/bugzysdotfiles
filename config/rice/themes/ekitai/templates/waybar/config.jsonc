// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/themes/{{name}}/templates/waybar/config.jsonc instead
// ekitai: three square boxes with hairline dividers. Icons are all Material Design (nf-md).
//   left   = 液 tile, workspaces, focused app
//   centre = clock (calendar on hover), date, music when it's playing
//   right  = cpu, memory, wifi, volume, record, rice picker
{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 0,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "modules-left": ["custom/ekitai", "hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock", "custom/date", "custom/cava", "custom/cmus"],
    "modules-right": ["cpu", "memory", "network", "pulseaudio", "custom/record", "custom/rice"],

    "custom/ekitai": {
        "format": "液",
        "tooltip-format": "apps",
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "active": "󰝤",
            "default": "󰝣",
            "empty": "󰝣"
        },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "hyprland/window": {
        "format": "{class}",
        "max-length": 24,
        "separate-outputs": true
    },

    "clock": {
        "format": "<b>{:%H:%M}</b>",
        "format-alt": "<b>{:%H:%M:%S}</b>",
        "interval": 1,
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "months":   "<span color='{{colors.bright}}'><b>{}</b></span>",
                "weekdays": "<span color='{{colors.accent2}}'>{}</span>",
                "days":     "<span color='{{colors.accent}}'>{}</span>",
                "today":    "<span background='{{colors.accent}}' color='{{colors.bg0}}'><b>{}</b></span>"
            }
        }
    },
    "custom/date": {
        "exec": "date '+%a %d %b'",
        "interval": 60,
        "tooltip": false
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "format": "{}",
        "tooltip": false
    },
    "custom/cmus": {
        "exec": "~/.config/waybar/scripts/cmus.sh status",
        "return-type": "json",
        "interval": 2,
        "signal": 8,
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/cmus.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/cmus.sh detach",
        "on-click-middle": "cmus-remote -u"
    },

    "cpu": {
        "format": "<span size='larger'>󰘚</span> {usage}%",
        "interval": 3
    },
    "memory": {
        "format": "<span size='larger'>󰍛</span> {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },
    "network": {
        "format-wifi": "<span size='larger'>{icon}</span> {essid}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "<span size='larger'>󰈀</span> wired",
        "format-disconnected": "<span size='larger'>󰤭</span> offline",
        "max-length": 22,
        "tooltip-format": "{ifname}  {ipaddr}  {signalStrength}%",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "kitty --class nmtui -e nmtui"
    },
    "pulseaudio": {
        "format": "<span size='larger'>{icon}</span> {volume}%",
        "format-muted": "<span size='larger'>󰖁</span> mute",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "~/.config/rice/vol mute",
        "on-scroll-up": "~/.config/rice/vol up",
        "on-scroll-down": "~/.config/rice/vol down",
        "scroll-step": 5
    },
    "custom/record": {
        "exec": "~/.config/waybar/scripts/record.sh status",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/record.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/record.sh region",
        "on-click-middle": "~/.config/waybar/scripts/record.sh folder"
    },
    "custom/rice": {
        "format": "<span size='larger'>󰏘</span>",
        "tooltip-format": "switch rice",
        "on-click": "rice"
    }
}
