// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/themes/{{name}}/templates/waybar/config.jsonc instead
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 0,
    "margin-top": 8,
    "modules-left": [],
    "modules-center": [
        "clock#time",
        "hyprland/workspaces",
        "clock#date",
        "custom/record"
    ],
    "modules-right": [],
    "custom/record": {
        "exec": "~/.config/waybar/scripts/record.sh status",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/record.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/record.sh region",
        "on-click-middle": "~/.config/waybar/scripts/record.sh folder"
    },
    "clock#time": {
        "format": "{:%H:%M:%S}",
        "interval": 1,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock#date": {
        "format": "{:%Y-%m-%d}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months": "<span color='{{colors.accent}}'><b>{}</b></span>",
                "weekdays": "<span color='{{colors.accent2}}'>{}</span>",
                "today": "<span color='{{colors.bright}}'><b><u>{}</u></b></span>"
            }
        }
    }
}
