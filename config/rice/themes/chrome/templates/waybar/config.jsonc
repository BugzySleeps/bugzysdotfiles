// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/themes/{{name}}/templates/waybar/config.jsonc instead
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "margin-top": 10,
    "margin-left": 14,
    "margin-right": 14,
    "modules-left": ["group/left"],
    "modules-center": ["group/center"],
    "modules-right": ["group/right"],

    "group/left":   { "orientation": "horizontal", "modules": ["custom/logo", "hyprland/workspaces"] },
    "group/center": { "orientation": "horizontal", "modules": ["clock", "clock#date", "custom/cava"] },
    "group/right":  { "orientation": "horizontal", "modules": ["tray", "custom/record", "cpu", "memory", "backlight", "pulseaudio", "network"] },

    "custom/record": {
        "exec": "~/.config/waybar/scripts/record.sh status",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/record.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/record.sh region",
        "on-click-middle": "~/.config/waybar/scripts/record.sh folder"
    },
    "custom/logo": {
        "format": "",
        "tooltip": false,
        "on-click": "wofi --show drun"
    },
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": { "default": " " },
        "persistent-workspaces": { "*": 5 },
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "format": {
                "months": "<span color='{{colors.accent}}'><b>{}</b></span>",
                "weekdays": "<span color='{{colors.accent2}}'>{}</span>",
                "today": "<span color='{{colors.bright}}'><b><u>{}</u></b></span>"
            }
        }
    },
    "clock#date": {
        "format": "{:%a  %d  %b}",
        "tooltip": false
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "format": "{}",
        "tooltip": false
    },
    "cpu":        { "format": "", "interval": 3, "tooltip-format": "cpu {usage}%" },
    "memory":     { "format": "󰍛", "interval": 5, "tooltip-format": "{used:0.1f} / {total:0.1f} GiB" },
    "backlight":  { "format": "{icon}", "format-icons": ["󰃞", "󰃟", "󰃠"], "tooltip-format": "brightness {percent}%" },
    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "󰝟",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "tooltip-format": "volume {volume}%",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "network": {
        "format-wifi": "󰖩",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "tooltip-format": "{essid}  {ipaddr}  {signalStrength}%",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh",
        "on-click-right": "kitty --class nmtui -e nmtui"
    },
    "tray": { "spacing": 8, "icon-size": 14 }
}
