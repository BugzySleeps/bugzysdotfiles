// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/themes/{{name}}/templates/fastfetch/config.jsonc
// ekitai: two bracketed trees, SYSTEM and MACHINE, all in one green.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "{{fastfetch.logo}}",
        "color": { "1": "{{fastfetch.logo1}}", "2": "{{fastfetch.logo2}}" },
        "padding": { "top": 1, "left": 2, "right": 6 }
    },
    "display": {
        "separator": "{{fastfetch.separator}}",
        "color": { "keys": "{{colors.accent}}", "title": "{{colors.accent}}", "output": "{{colors.accent}}", "separator": "{{colors.accent}}" },
        "percent": { "color": { "green": "{{colors.accent}}", "yellow": "{{colors.accent}}", "red": "{{term.color1}}" } },
        "bar": { "char": { "elapsed": "■", "total": "·" } }
    },
    "modules": [
        "break",
        { "type": "title",    "key": "[󰣨] ─ [SYSTEM]", "format": "{user-name}@{host-name}" },
        { "type": "os",       "key": " ├ 󰌽" },
        { "type": "kernel",   "key": " ├ 󰒋" },
        { "type": "uptime",   "key": " ├ 󰅐" },
        { "type": "packages", "key": " ├ 󰏖", "format": "{all}" },
        { "type": "shell",    "key": " ├ 󰆍" },
        { "type": "wm",       "key": " ├ 󰖯" },
        { "type": "terminal", "key": " ├ 󰞷" },
        { "type": "custom",   "format": " └{{fastfetch.rule}}┤ 液体" },
        "break",
        { "type": "host",     "key": "[󰌢] ─ [MACHINE]" },
        { "type": "cpu",      "key": " ├ 󰻠" },
        { "type": "gpu",      "key": " ├ 󰢮", "format": "{name}" },
        { "type": "memory",   "key": " ├ 󰍛" },
        { "type": "disk",     "key": " ├ 󰋊", "folders": "/" },
        { "type": "custom",   "format": " └{{fastfetch.rule}}┤" }
    ]
}
