// GENERATED by `rice` ({{name}}) — edit ~/.config/rice/themes/{{name}}/templates/waybar/config.jsonc instead
{
    "layer": "top",
    "position": "top",
    "height": 22,
    "spacing": 0,
    "margin-top": 8,
    "modules-left": ["custom/music"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["custom/record", "clock"],
    "custom/music": {
        "exec": "~/.config/waybar/scripts/music.sh",
        "format": "{}",
        "max-length": 70,
        "on-click": "playerctl -p cmus,swiftify play-pause",
        "on-scroll-up": "playerctl -p cmus,swiftify previous",
        "on-scroll-down": "playerctl -p cmus,swiftify next"
    },
    "custom/record": {
        "exec": "~/.config/waybar/scripts/record.sh status",
        "return-type": "json",
        "format": "{}",
        "on-click": "~/.config/waybar/scripts/record.sh toggle",
        "on-click-right": "~/.config/waybar/scripts/record.sh region",
        "on-click-middle": "~/.config/waybar/scripts/record.sh folder"
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %d %B %Y}"
    },
    "hyprland/workspaces": {
        "format": "{name}",
        "on-scroll-up": "hyprctl dispatch workspace e-1",
        "on-scroll-down": "hyprctl dispatch workspace e+1"
    }
}
