#!/usr/bin/env bash
# screenshot [region|full|window|bar] — save to ~/Pictures/Screenshots and copy to clipboard
# region: with the Quickshell rice running, the shot opens in its editor first (draw, crop, then save/copy)
# needs: grim slurp wl-clipboard

mode=${1:-region}
dir=~/Pictures/Screenshots
file="$dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$dir"

notify() { timeout 3 notify-send -a screenshot "$@" 2>/dev/null & }

for dep in grim slurp wl-copy; do
    if ! command -v "$dep" >/dev/null; then
        notify "Screenshot failed" "missing $dep — run: sudo pacman -S grim slurp wl-clipboard"
        exit 1
    fi
done

# MacShell does it all itself, the macOS way (the toolbar, a floating thumbnail, Markup): hand it over when it's the
# shell running (the others don't answer "shot take", and carry on below)
case $mode in region) want=area ;; full) want=full ;; window) want=window ;; bar) want=bar ;; *) want= ;; esac
# (asked only if it has "shot take": qs ipc call exits 0 even when the function isn't there)
shell=$(sed -n 's/^quickshell *= *"\([^"]*\)".*/\1/p' ~/.config/rice/themes/"$(cat ~/.config/rice/current 2>/dev/null)"/theme.toml 2>/dev/null)
if [ -n "$want" ] && [ -n "$shell" ] && qs -c "$shell" ipc show 2>/dev/null | grep -q 'function take(what'; then
    qs -c "$shell" ipc call shot take "$want" >/dev/null 2>&1 && exit 0
fi
[ "$mode" = bar ] && mode=region

case $mode in
    region) geom=$(slurp -d -b 00000066 -c ffffffcc) || exit 0 ;;   # Esc cancels
    window) geom=$(hyprctl activewindow -j | python3 -c \
                'import json,sys; w=json.load(sys.stdin); print(f"{w[\"at\"][0]},{w[\"at\"][1]} {w[\"size\"][0]}x{w[\"size\"][1]}")') || exit 1 ;;
    full)   geom= ;;
    *)      echo "usage: screenshot [region|full|window]"; exit 1 ;;
esac

# region shots go to the Quickshell editor when it's there (it saves / copies / throws away itself)
if [ "$mode" = region ] && command -v qs >/dev/null && qs -c ekitai ipc show >/dev/null 2>&1; then
    raw="${XDG_RUNTIME_DIR:-/tmp}/ekitai-shot-$(date +%s%N).png"
    grim -g "$geom" "$raw" || exit 1
    qs -c ekitai ipc call shot edit "$raw" >/dev/null 2>&1 && exit 0
    mv "$raw" "$file" && wl-copy < "$file" && notify -i "$file" "Screenshot saved" "$file"
    exit 0
fi

if [ -n "$geom" ]; then grim -g "$geom" "$file"; else grim "$file"; fi || exit 1
wl-copy < "$file"
notify -i "$file" "Screenshot saved" "$file"
